INNO_HOME=./runtime
INNO_CONFIG_DIR=./runtime/config
INNO_SKILLS_DIR=./runtime/skills
# Preset workspace templates: set presets.dir in config.json (default: <codeDir>/presets)
INNO_WORKSPACE_DIR=./workspace
INNO_PORT=3000
# The server always requires Better Auth accounts backed by PostgreSQL;
# every API request is tenant-scoped. Bind to a non-loopback address only
# behind TLS-terminating infrastructure you control.
# INNO_HOST=0.0.0.0

# Required: Better Auth + PostgreSQL. The server refuses to boot without
# these. Run migrations once per database: npm --workspace inno-agent run auth:migrate
DATABASE_URL=postgresql://inno:inno@127.0.0.1:5432/inno
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# INNO_TRUSTED_ORIGINS=http://localhost:5173
# INNO_AUTH_ALLOW_SIGNUP=true
# Optional static tenant-owner routing across workers. Catalog, recovery, and
# memory live in PostgreSQL; file bytes live in object storage. A session still
# has one owner at a time: local exec uses that worker's workspace directory,
# and deferred timers / live SSE subscribers stay on the process that armed
# them. A dead owner's session is taken over lazily by the next request.
# Every worker gets the same map and its own ID.
# INNO_DURABLE_SHARD_ID defaults to HOSTNAME when unset (matches k8s StatefulSet
# pod names / compose container names).
# INNO_DURABLE_SHARD_ID=worker-a
# INNO_DURABLE_SHARD_URLS={"worker-a":"http://worker-a:3000","worker-b":"http://worker-b:3000"}
# k8s StatefulSet + headless service alternative: one {id} URL template plus a
# peer list (IDS) or generated ordinals (PREFIX+COUNT -> prefix-0..N-1).
# INNO_DURABLE_SHARD_URL_TEMPLATE=http://{id}.inno-headless:3000
# INNO_DURABLE_SHARD_IDS=inno-agent-0,inno-agent-1,inno-agent-2
# INNO_DURABLE_SHARD_PREFIX=inno-agent
# INNO_DURABLE_SHARD_COUNT=3
# INNO_WORKER_TOKEN=                        # shared secret authenticating POST /api/internal/durable-prompt
                                          # (cross-worker prompt forwarding); unset = endpoint 404s

# Log verbosity (logs go to stdout; default: info)
# LOG_LEVEL=info
# Include truncated LLM request/response bodies in the log (privacy-sensitive:
# prompts, user messages and model output end up in the server logs).
# Default off — only metadata (URL, status, timing, body sizes) is logged.
# LOG_LLM_BODY=0

# Platform-level object storage (S3-compatible: Alibaba Cloud OSS in production, MinIO locally).
# Holds platform/skills/…, tenants/<t>/workspaces/… (chat images included),
# tenants/<t>/l2/…, and tenants/<t>/outbox/….
# Unset = in-memory store (tests / single-process trials only; cannot share across workers).
# INNO_OBJECT_STORAGE_PROVIDER=s3            # s3 | fs | memory
# INNO_OBJECT_STORAGE_DIR=                   # provider=fs: directory mirroring object keys (single-host workers/tests)
# INNO_OBJECT_STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# INNO_OBJECT_STORAGE_REGION=oss-cn-hangzhou
# INNO_OBJECT_STORAGE_BUCKET=
# INNO_OBJECT_STORAGE_ACCESS_KEY_ID=
# INNO_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# INNO_OBJECT_STORAGE_FORCE_PATH_STYLE=   # true for MinIO; inferred from the endpoint when unset
# INNO_OBJECT_STORAGE_PUBLIC_ENDPOINT=    # presigned URLs are issued against this endpoint when
#                                         # it differs from ENDPOINT (OSS 内网 endpoint + 公网
#                                         # presign, or compose `minio:9000` + host-published port)
# With provider=s3 the panel uses presigned direct upload/download — OSS needs
# bucket CORS rules allowing browser PUT/GET from the web origin; MinIO allows
# CORS by default. The fallback proxied path needs no CORS at all.

# Remote sandbox for shell/file tools (E2B-compatible; self-hosted services set E2B_DOMAIN).
# INNO_SANDBOX_ENABLED=false
# E2B_API_KEY=
# E2B_DOMAIN=            # omit for the E2B cloud
# E2B_TEMPLATE=          # non-default sandbox image, optional

# Local execution provider: bash/file tools run on the worker inside the
# workspace directory (ignored while INNO_SANDBOX_ENABLED is on).
# INNO_EXEC_BACKEND=persistent        # persistent (default, no bash) | local
# INNO_EXEC_LOCAL_MAX_CONCURRENT=0    # 0 = unlimited active local backends
