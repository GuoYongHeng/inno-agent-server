# Frontend image: the Vite-built web UI served by nginx, which also reverse-proxies
# /api and /health to the backend (BACKEND_URL, default http://inno-agent:3000).
# Build from the repo root:
#   docker build -f deploy/Dockerfile.frontend -t inno-agent-frontend .

# Stage 1: Build — Vite production bundle
FROM node:22-bookworm AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/inno-agent/package.json apps/inno-agent/tsconfig.json apps/inno-agent/
COPY apps/inno-agent/web/package.json apps/inno-agent/web/tsconfig.json apps/inno-agent/web/
# Vendored xlsx tarball — pulled in via a `file:` dependency, must exist before npm ci.
COPY vendor/ vendor/

RUN npm config set registry https://registry.npmmirror.com && npm ci

COPY apps/inno-agent/web/src apps/inno-agent/web/src/
# The web sources import types/helpers shared with the backend (web/src -> ../../../src/shared).
COPY apps/inno-agent/src/shared apps/inno-agent/src/shared/
COPY apps/inno-agent/web/public apps/inno-agent/web/public/
COPY apps/inno-agent/web/vite.config.ts apps/inno-agent/web/index.html apps/inno-agent/web/

RUN npm --workspace inno-agent-web run build

# Stage 2: nginx serving the static bundle
FROM nginx:1.27-alpine AS runtime

ENV BACKEND_URL=http://inno-agent:3000

# The official image renders /etc/nginx/templates/*.template with envsubst on start.
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/inno-agent/web/dist /usr/share/nginx/html

EXPOSE 80
