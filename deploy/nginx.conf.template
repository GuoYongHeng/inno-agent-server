server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Vite emits .gz siblings for text assets; serve them as-is.
    gzip_static on;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Workspace/wiki/skill uploads go up to 192 MiB (backend UPLOAD_MAX_BODY_BYTES).
    client_max_body_size 200m;

    # API: chat turns are SSE streams, so no buffering and a long read timeout.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /health {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    # Hashed bundles: cache forever; a miss must be a real 404, never index.html.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback for client-side routes.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
