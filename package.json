{
	"name": "inno-agent",
	"version": "0.7.0",
	"private": true,
	"description": "Personal learning agent built on PI SDK with three-layer memory system",
	"author": "Inno Agent Contributors",
	"type": "module",
	"workspaces": [
		"apps/inno-agent",
		"apps/inno-agent/web",
		"apps/showcase"
	],
	"scripts": {
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"benchmark:durable": "tsx apps/inno-agent/src/agent/durable-capacity.ts",
		"eval:l2-retrieval": "tsx scripts/eval-l2-retrieval.ts",
		"build": "npm --workspace inno-agent run build && npm --workspace inno-agent-web run build",
		"server": "npm --workspace inno-agent run server --",
		"sandbox:fsck": "npm --workspace inno-agent run sandbox:fsck --",
		"skills:publish": "npm --workspace inno-agent run skills:publish --",
		"web:dev": "npm --workspace inno-agent-web run dev",
		"dev:server": "npm --workspace inno-agent run server --",
		"restart": "bash restart-dev.sh",
		"restart:fast": "bash restart-dev.sh --skip-build",
		"showcase:dev": "npm run dev --workspace inno-agent-showcase",
		"showcase:build": "npm run build --workspace inno-agent-showcase",
		"skills:import-hub": "npm --workspace inno-agent run skills:import-hub --"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.7",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.3.0",
		"concurrently": "^9.2.1",
		"jsdom": "^30.0.1",
		"shx": "^0.4.0",
		"tailwindcss": "^4.1.7",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2",
		"vite": "^6.3.5",
		"vitest": "^3.2.4",
		"xlsx": "file:./vendor/xlsx-0.20.3.tgz"
	},
	"overrides": {
		"@larksuiteoapi/node-sdk": {
			"axios": "^1.16.1"
		},
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		},
		"xlsx": "$xlsx"
	}
}
