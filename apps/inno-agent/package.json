{
	"name": "inno-agent",
	"version": "0.7.0",
	"description": "Personal learning agent built on PI SDK with three-layer memory system",
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"server": "node dist/server.js",
		"sandbox:fsck": "node dist/durable-sandbox-fsck.js",
		"web:dev": "npm --workspace inno-agent-web run dev",
		"web:build": "npm --workspace inno-agent-web run build",
		"auth:migrate": "tsx src/auth/migrate.ts",
		"auth:schema": "tsx src/auth/migrate.ts --print",
		"skills:publish": "tsx src/skills/publish-cli.ts",
		"workspace:fsck": "node dist/workspace-fsck.js",
		"platform:config": "tsx src/platform-config-cli.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1173.0",
		"@aws-sdk/s3-request-presigner": "3.1173.0",
		"@better-auth/core": "1.7.12",
		"@better-auth/utils": "0.5.0",
		"@better-fetch/fetch": "1.3.2",
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@larksuiteoapi/node-sdk": "^1.63.1",
		"@llamaindex/liteparse": "^1.3.0",
		"@tavily/core": "^0.7.6",
		"better-auth": "1.7.12",
		"cron-parser": "^5.5.0",
		"e2b": "^2.64.0",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"pg": "8.23.1",
		"pino": "^10.3.1",
		"pino-caller": "^4.0.0",
		"source-map-support": "^0.5.21",
		"typebox": "^1.3.7",
		"undici": "^7.19.1",
		"yaml": "^2.6.1"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/pg": "8.16.0",
		"@types/pino": "^7.0.4",
		"graphology-types": "0.24.8"
	}
}
