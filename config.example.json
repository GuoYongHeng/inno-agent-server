{
	"defaultProvider": "innospark",
	"defaultModel": "claude-sonnet-4-6",
	"providers": {
		"innospark": {
			"baseUrl": "https://api.innospark.cn",
			"api": "anthropic-messages",
			"apiKey": "replace-me",
			"authHeader": false,
			"bypassProxy": false,
			"models": [
				{
					"id": "claude-sonnet-4-6",
					"name": "Claude Sonnet 4.6 via InnoSpark",
					"reasoning": true,
