		"wechat": {
			"enabled": false,
			"mode": "bridge",
			"allowedUserIds": [],
			"sidecarBaseUrl": "http://127.0.0.1:4319"
		}
	},
	"bridge": {
		"token": "replace-me-with-a-secret"
	},
	"contentHub": {
		"type": "github",
		"owner": "Chloris-Blaxk",
		"repo": "inno-agent-hub",
		"ref": "main",
		"skillsPath": "skill-library",
		"baseUrl": "",
		"token": ""
	},
	"tavily": {
		"apiKey": ""
	},
	"sandbox": {
		"enabled": false,
		"provider": "e2b",
		"apiKey": "",
		"requireApproval": "always",
		"timeoutMinutes": 30,
		"commandTimeoutSeconds": 600,
		"allowInternetAccess": true,
		"allowedDomains": [],
